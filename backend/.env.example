# Server-only Transactions API and worker configuration. Never commit real values.
APP_ENV=development
API_ADDRESS=:8080

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_DB_URL=postgresql://postgres.project:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

GOOGLE_OAUTH_CLIENT_ID=replace-with-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/v1/transactions/gmail/oauth/callback
TRANSACTION_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

ALIBABA_TOKEN_PLAN_API_KEY=replace-with-server-only-key
ALIBABA_TOKEN_PLAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Provider model. Defaults to qwen3.8-flash when unset; override as needed.
ALIBABA_TOKEN_PLAN_MODEL=qwen3.8-flash

FRONTEND_ORIGIN=http://localhost:5173
# Gmail label to ingest. Defaults to odin-finance when unset.
GMAIL_SYNC_LABEL=odin-finance
# Messages imported on the first sync. Optional; defaults to 5, allowed range 1-100.
GMAIL_INITIAL_BACKFILL_MAX_MESSAGES=5
WORKER_POLL_SECONDS=5
OUTBOUND_HTTP_TIMEOUT_SECONDS=20
BULK_IMPORT_ENABLED=false
BULK_IMPORT_RENDER_TIMEOUT_SECONDS=30
BULK_IMPORT_PROVIDER_TIMEOUT_SECONDS=30
BULK_IMPORT_MAX_RENDERED_PAGE_BYTES=1048576
BULK_IMPORT_MAX_RENDERED_DOCUMENT_BYTES=52428800

# Local development only. Do not set in deployed environments.
# GOOGLE_TEST_REFRESH_TOKEN=
